        <mxCell id="WIT0911" parent="1" style="ellipse;fontFamily=Arial;fontSize=10;html=1;whiteSpace=wrap;fontStyle=1;fillColor=#2F9DD1;strokeColor=#1B78A6;strokeWidth=2;fontColor=#FFFFFF;" value="&lt;b&gt;WIT0911&lt;/b&gt;&lt;br&gt;รับความประสงค์อุทธรณ์&lt;br&gt;จากหน้า 09A" vertex="1">
          <mxGeometry height="82" width="105" x="78" y="73" as="geometry" />
